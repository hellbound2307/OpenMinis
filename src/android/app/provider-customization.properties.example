# provider-customization.properties.example
#
# Template for build-time customization values. Copy this file to
# provider-customization.properties (same directory) and fill in the values.
#
# Leaving a value empty is allowed for building; the app fails at runtime the
# first time that value is actually needed.

# Only needed to sign in with Claude OAuth credentials (API keys do not need
# it). Requests authenticated with OAuth must open their system prompt with
# the identifying line Claude Code itself sends, or the endpoint rejects them.
# We ship no value — supply your own. Other open-source projects talking to
# the same endpoint declare the same identifier, e.g.
# https://github.com/Wei-Shaw/claude-relay-service
ANTHROPIC_OAUTH_IDENTIFIER_PROMPT=

# Google (Gemini) OAuth client for "Sign in with Google". Empty means the
# public Gemini CLI installed-app client is used (the same client the flow
# targets by default; the installed-app secret is not a confidential value —
# Gemini CLI ships it in its own public repository). Set both values only if
# you want to route sign-ins through your own GCP OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Antigravity OAuth client (the Cloud Code surface that replaced the
# retired "Gemini Code Assist for individuals" OAuth). Empty means the
# Antigravity IDE's installed-app client is used (same as the iOS build and
# the community tooling; the installed-app secret is not a confidential
# value — the Antigravity IDE ships it in its own binary). Set both values
# only if you want to route sign-ins through your own GCP OAuth client.
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
